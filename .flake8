[flake8]
# Flake8 Configuration for PromoTales Bot

# Maximum line length to match Black
max-line-length = 100

# Directories to exclude from linting
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .tox,
    .mypy_cache,
    .pytest_cache,
    migrations

# Ignore specific error codes
ignore =
    E203,  # Whitespace before ':' (conflicts with Black)
    E266,  # Too many leading '#' for block comment
    E501,  # Line too long (handled by Black)
    W503,  # Line break before binary operator (conflicts with Black)
    W504,  # Line break after binary operator
    F401,  # Module imported but unused (sometimes needed for __init__.py)

# Maximum complexity
max-complexity = 15

# Show source code for errors
show-source = True

# Statistics
count = True
statistics = True

# Per-file ignores
per-file-ignores =
    __init__.py:F401
    tests/*:F401,F811
